{
    "version": "0.2.0",
    "configurations": [
      {
        "name": "Debug BEVFusion Training",  // 配置名称，显示在 VSCode 调试选项中
        "type": "debugpy",  // 调试类型为 Python
        "python": "/home/student/miniconda3/envs/openmmlab/bin/python",
        "request": "launch",
        "module": "torch.distributed.launch",
        "args": [
          // 训练脚本的参数，等同于 bash 命令中的参数部分
          "--nnodes=1",
          "--node_rank=0",
          "--master_addr=127.0.0.1",
          "--nproc_per_node=1",
          "--master_port=29500",
          "./tools/train.py",
          "./projects/BEVFusion/configs/bevfusion_lidar-cam_voxel0075_second_secfpn_8xb4-cyclic-20e_nus-3d.py",
          "--launcher=pytorch",
          "--cfg-options", 
          "load_from=/home/student/mmdetection3d/checkpoints/bevfusion_lidar_voxel0075_second_secfpn_8xb4-cyclic-20e_nus-3d-2628f933.pth",  // 加载模型检查点
          "model.img_backbone.init_cfg.checkpoint=/home/student/mmdetection3d/checkpoints/swint-nuimages-pretrained.pth"  // 预训练模型路径
        ],
        "cwd": "/home/student/mmdetection3d",
        "env": {
                "PYTHONPATH": "${workspaceFolder}:${env:PYTHONPATH}"
            },
      },
      {
        "name": "Debug BEVFusion testing",  // 配置名称，显示在 VSCode 调试选项中
